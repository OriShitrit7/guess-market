<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="300.0" minWidth="720.0" prefHeight="650.0" prefWidth="1001.0" spacing="0.0" stylesheets="@account.css" xmlns="http://javafx.com/javafx/25.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.client.components.account.AccountController">
   <children>
      <fx:include fx:id="loadFileComponent" source="loadfile/load-file.fxml">
         <VBox.margin>
            <Insets left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </fx:include>
      <HBox spacing="0.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox maxWidth="330.0" minWidth="300.0" prefWidth="310.0" spacing="10.0">
               <children>
                  <fx:include fx:id="walletComponent" maxHeight="300.0" maxWidth="1.7976931348623157E308" minHeight="190.0" prefHeight="260.0" source="accountdetails/wallet/wallet.fxml" />
                  <fx:include fx:id="usersTableComponent" source="userstable/users-table.fxml" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <Separator orientation="VERTICAL" styleClass="panel-divider" />
            <fx:include fx:id="myEventsComponent" source="accountdetails/myevents/my-events.fxml" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>

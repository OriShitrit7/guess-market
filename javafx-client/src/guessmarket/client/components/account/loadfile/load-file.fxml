<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<HBox alignment="CENTER_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/25.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.client.components.account.loadfile.LoadFileController">
   <children>
      <Button fx:id="loadFileButton" mnemonicParsing="false" onAction="#loadFileButtonAction" styleClass="load-file-button" text="Load File" />
      <StackPane alignment="CENTER_LEFT">
         <children>
            <Label fx:id="filePathLabel" maxWidth="1.7976931348623157E308" styleClass="file-path-label" visible="false" />
            <ProgressBar fx:id="loadFileProgressBar" prefWidth="240.0" progress="0.0" styleClass="file-load-progress" visible="false" />
         </children>
      </StackPane>
   </children>
</HBox>

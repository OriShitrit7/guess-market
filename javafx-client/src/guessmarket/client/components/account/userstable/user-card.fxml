<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="userCard" alignment="CENTER_LEFT" focusTraversable="true" maxWidth="1.7976931348623157E308" minHeight="72.0" minWidth="180.0" spacing="7.0" styleClass="user-card" stylesheets="@user-card.css" xmlns="http://javafx.com/javafx/25.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.client.components.account.userstable.UserCardController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label fx:id="userNameLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="user-card-name" text="User Name" wrapText="true" HBox.hgrow="ALWAYS" />
            <Label fx:id="userStatusLabel" minWidth="-Infinity" styleClass="user-status-badge" text="Active" />
         </children>
      </HBox>
      <Label fx:id="marketMakerLabel" styleClass="user-card-market-maker" text="Market Maker" />
      <HBox alignment="CENTER_LEFT" spacing="7.0">
         <children>
            <Label styleClass="user-card-balance-caption" text="Balance" />
            <Label fx:id="userBalanceLabel" styleClass="user-card-balance-value" text="\$0.00" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
   </padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="516.0" minWidth="740.0" prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.client.components.main.MainController">
   <top>
      <VBox alignment="TOP_LEFT" spacing="7.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="app-title-block">
               <children>
                  <Label styleClass="app-title" text="Guess Market" />
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TabPane minHeight="400.0" minWidth="720.0" styleClass="main-tab-pane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
            <Tab text="Events">
               <content>
                  <fx:include fx:id="eventsComponent" source="../events/events.fxml" />
               </content>
            </Tab>
            <Tab text="Account">
               <content>
                  <fx:include fx:id="accountComponent" source="../account/account.fxml" />
               </content>
            </Tab>
            <Tab fx:id="chatTab" text="Chat">
               <content>
                  <fx:include fx:id="chatComponent" source="../chat/chat.fxml" />
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="eventCard" focusTraversable="true" minHeight="-Infinity" minWidth="-Infinity" prefWidth="250.0" spacing="8.0" styleClass="event-card" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.ui.javafx.components.events.EventCardController">
   <children>
      <HBox alignment="CENTER_LEFT" minHeight="44.0" prefHeight="44.0" spacing="10.0" styleClass="event-card-header">
         <children>
            <Label fx:id="eventNameLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="140.0" styleClass="event-card-title" text="Event Name" wrapText="true" HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" minWidth="-Infinity" styleClass="event-status-badge" text="Status" />
         </children>
      </HBox>
      <Separator maxWidth="1.7976931348623157E308" styleClass="event-card-header-separator" />
      <Label fx:id="tradingMethodLabel" styleClass="trading-method-badge" text="LMSR Trading" />
      <VBox spacing="3.0" styleClass="commission-summary">
         <children>
            <Label styleClass="event-card-caption" text="COMMISSION" />
            <Label fx:id="commissionDescriptionLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="commission-description" text="10% · Charged when event closes" wrapText="true" />
         </children>
      </VBox>
      <Separator maxWidth="1.7976931348623157E308" />
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="event-account-row">
         <children>
            <Label styleClass="event-account-title" text="Event Account" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="eventAccountLabel" styleClass="event-account-value" text="0.00" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
</VBox>

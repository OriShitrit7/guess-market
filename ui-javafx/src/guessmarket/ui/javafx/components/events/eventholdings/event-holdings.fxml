<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="1.7976931348623157E308" spacing="6.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.ui.javafx.components.events.eventholdings.EventHoldingsController">
   <children>
      <Label styleClass="section-title" text="EVENT HOLDINGS" />
      <TableView fx:id="holdingsTable" maxWidth="1.7976931348623157E308" prefHeight="160.0">
        <columns>
          <TableColumn fx:id="userColumn" prefWidth="100.0" reorderable="false" text="User" />
          <TableColumn fx:id="firstOptionQuantityColumn" prefWidth="90.0" reorderable="false" text="Option1" />
            <TableColumn fx:id="firstOptionValueColumn" prefWidth="90.0" reorderable="false" text="Value" />
            <TableColumn fx:id="secondOptionQuantityColumn" prefWidth="90.0" reorderable="false" text="Option2" />
            <TableColumn fx:id="secondOptionValueColumn" prefWidth="90.0" reorderable="false" text="Value" />
            <TableColumn fx:id="openOrdersColumn" prefWidth="60.0" reorderable="false" text="Open" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>

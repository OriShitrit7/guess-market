<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.ui.javafx.components.events.lmsrdetails.LmsrDetailsController">
   <children>
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="10.0">
         <children>
            <Label text="MM :" />
            <Label fx:id="marketMakerLabel" text="-" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="eventNameLabel" text="Event Name">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="eventStatusLabel" text="Status" />
         </children>
      </HBox>
      <HBox maxWidth="1.7976931348623157E308" spacing="15.0">
         <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="eventDescriptionLabel" text="Description" wrapText="true" />
                  <GridPane vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                      <ColumnConstraints halignment="RIGHT" hgrow="ALWAYS" minWidth="10.0" prefWidth="80.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" vgrow="NEVER" />
                      <RowConstraints minHeight="10.0" vgrow="NEVER" />
                      <RowConstraints minHeight="10.0" vgrow="NEVER" />
                    </rowConstraints>
                     <children>
                        <Label text="Commission :" />
                        <Label fx:id="eventCommissionLabel" text="-" GridPane.columnIndex="1" />
                        <Label text="Event Account :" GridPane.rowIndex="1" />
                        <Label fx:id="eventAccountLabel" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Total Commission Collected :" GridPane.rowIndex="2" />
                        <Label fx:id="totalCommissionCollectedLabel" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </children>
                  </GridPane>
               </children>
            </VBox>
            <VBox minWidth="200.0" spacing="8.0">
               <children>
                  <VBox spacing="4.0" styleClass="option-card">
                     <children>
                        <Label fx:id="firstOptionNameLabel" text="Option1">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <GridPane hgap="8.0" vgap="2.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" vgrow="NEVER" />
                            <RowConstraints minHeight="10.0" vgrow="NEVER" />
                          </rowConstraints>
                           <children>
                              <Label text="Current Value :" />
                              <Label fx:id="firstOptionValueLabel" text="-" GridPane.columnIndex="1" />
                              <Label text="Shares Bought :" GridPane.rowIndex="1" />
                              <Label fx:id="firstOptionSharesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                     </children>
                     <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </VBox>
                  <VBox spacing="4.0" styleClass="option-card">
                     <children>
                        <Label fx:id="secondOptionNameLabel" text="Option2">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <GridPane hgap="8.0" vgap="2.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" vgrow="NEVER" />
                            <RowConstraints minHeight="10.0" vgrow="NEVER" />
                          </rowConstraints>
                           <children>
                              <Label text="Current Value :" />
                              <Label fx:id="secondOptionValueLabel" text="-" GridPane.columnIndex="1" />
                              <Label text="Shares Bought :" GridPane.rowIndex="1" />
                              <Label fx:id="secondOptionSharesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                     </children>
                     <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" />
                     </VBox.margin>
                  </VBox>
               </children>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
      <fx:include fx:id="eventResultComponent" managed="false" source="../eventresult/event-result.fxml" visible="false" />
      <VBox maxWidth="1.7976931348623157E308" spacing="6.0">
         <children>
            <Label text="Trade History">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TableView fx:id="tradeHistoryTable" maxWidth="1.7976931348623157E308" prefHeight="180.0">
              <columns>
                <TableColumn fx:id="tradeUserColumn" prefWidth="90.0" reorderable="false" text="User" />
                <TableColumn fx:id="tradeOptionColumn" prefWidth="110.0" reorderable="false" text="Option" />
                  <TableColumn fx:id="tradeQuantityColumn" prefWidth="80.0" reorderable="false" text="Quantity" />
                  <TableColumn fx:id="tradePaidColumn" prefWidth="80.0" reorderable="false" text="Paid" />
                  <TableColumn fx:id="tradeCommissionColumn" prefWidth="90.0" reorderable="false" text="Commission" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <fx:include fx:id="eventHoldingsComponent" source="../eventholdings/event-holdings.fxml" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>

<?import javafx.scene.layout.HBox?>

<HBox fx:id="userCard" alignment="CENTER_LEFT" focusTraversable="true" minHeight="72.0" minWidth="180.0" prefHeight="72.0" prefWidth="245.0" spacing="10.0" styleClass="user-card" xmlns="http://javafx.com/javafx/25.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.ui.javafx.components.users.UserCardController">
   <children>
      <Label fx:id="userNameLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="1.0" styleClass="user-card-name" text="User Name" wrapText="true" HBox.hgrow="ALWAYS" />
      <Label fx:id="userStatusLabel" minWidth="-Infinity" styleClass="user-status-badge" text="Active" />
   </children>
   <padding>
      <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
   </padding>
</HBox>
